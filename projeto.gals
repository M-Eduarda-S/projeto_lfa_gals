#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
Package = gals
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
Parser = SLR
#RegularDefinitions

#Tokens
 :[\ \n\t\r\s]+
print: "Show"
binario: [0-1]+
id: [a-zA-Z][a-zA-Z0-9]*
soma: "+"
sub: "-"
mult: "*"
div: "/"
exp: "^"
log: "log"
igual: "="
abreParentese: "("
fechaParentese: ")"
final: ";"
#NonTerminals
<lista_comandos>
<comando>
<atribuicao>
<expressao>
<termo>
<potencia>
<valor>
#Grammar
<lista_comandos> ::= <comando> <lista_comandos> | <comando>;
<comando> ::= <atribuicao> | print abreParentese id #2 fechaParentese final;
<atribuicao> ::= id #11 igual <expressao> final #9;
<expressao> ::= <expressao> soma <termo> #3 | <expressao> sub <termo> #4 | <termo>;
<termo> ::= <termo> mult <potencia> #5 | <termo> div <potencia> #6 | <potencia>;
<potencia> ::= <valor> exp <potencia> #7 | log <valor> #8 | <valor>;
<valor> ::= binario #1 | id #12 | abreParentese <expressao> fechaParentese;
