#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
Package = gals
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
Parser = SLR
#RegularDefinitions

#Tokens
: [\s\t\n\r]+
numeros: [0-1]+
soma: "+"
sub: "-"
mult: "*"
div: "/"
exp: "^"
log: “log”
abre_paren: "("
fecha_paren: ")"
igual: "="
ponto_virgula: “;”
imprimir: “Show”
var: [a-zA-Z][a-zA-Z0-9]* 
#NonTerminals
<lista_comandos>
<comando>
<atribuicao>
<expressao>
<termo>
<potencia>
<fator>
#Grammar
<lista_comandos> ::= <comando> <lista_comandos> | <comando>;
<comando> ::= <atribuicao> | imprimir abre_paren var #2 fecha_paren ponto_virgula;
<atribuicao> ::= var #11 igual <expressao> ponto_virgula #9;
<expressao> ::= <expressao> soma <termo> #3 | <expressao> sub <termo> #4 | <termo>;
<termo> ::= <termo> mult <potencia> #5 | <termo> div <potencia> #6 | <potencia>;
<potencia> ::= <fator> exp <potencia> #7 | log <fator> #8 | <fator>;
<fator> ::= numeros #1 | var  #12 | abre_paren <expressao> fecha_paren;
